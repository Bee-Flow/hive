# Bee Flow Frontend — environment template
#
# Copy this file to `.env` and adjust values for your dev setup.
# Vite picks up VITE_* vars at build time; everything else is ignored
# by the SPA but may be used by tooling.

# Base URL of the Bee Flow server (REST + SSE).
# - Dev with the OSS bee-flow-server repo on the same host: http://localhost:3101
# - Self-hosted on your own domain: https://api.your-domain.example
# - Bee Flow managed SaaS: https://api.beeflow.ai
VITE_API_URL=http://localhost:3101

# Vite `--base` for hosting under a path prefix. Leave as `/` unless you're
# embedding Bee Flow under a sub-path (e.g. `/bee-flow/` behind a reverse proxy).
VITE_PUBLIC_URL=/

# ── OpenObserve RUM + browser-logs (production only) ────────────────────────
# Real-user monitoring only beacons when a client token is set AND this is a
# production build (import.meta.env.PROD). Leave blank for dev/self-host to
# disable entirely. Values are baked into the bundle at build time, so each
# environment needs its own build. The client token is a write-only ingest
# token — safe to ship in the bundle.
VITE_OPENOBSERVE_ENABLE=true
VITE_OPENOBSERVE_CLIENT_TOKEN=
VITE_OPENOBSERVE_APPLICATION_ID=bee-flow-agent-hub
VITE_OPENOBSERVE_SITE=observe.beeflow.nl
VITE_OPENOBSERVE_ORG=default
VITE_OPENOBSERVE_SERVICE=agent-hub
VITE_OPENOBSERVE_ENV=production
# Session replay is OFF by default (0). Raise to e.g. 20 to record 20% of
# sessions with mask-all privacy. See src/telemetry/openobserve.js.
VITE_OPENOBSERVE_REPLAY_SAMPLE_RATE=0
VITE_OPENOBSERVE_SESSION_SAMPLE_RATE=100
