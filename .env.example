# Bee Flow Frontend — environment template
#
# Copy this file to `.env` and adjust values for your dev setup.
# Vite picks up VITE_* vars at build time; everything else is ignored
# by the SPA but may be used by tooling.

# Base URL of the Bee Flow server (REST + SSE).
# - Dev with the OSS bee-flow-server repo on the same host: http://localhost:3101
# - Self-hosted on your own domain: https://api.your-domain.example
# - Bee Flow managed SaaS: https://api.beeflow.ai
VITE_API_URL=http://localhost:3101

# Vite `--base` for hosting under a path prefix. Leave as `/` unless you're
# embedding Bee Flow under a sub-path (e.g. `/bee-flow/` behind a reverse proxy).
VITE_PUBLIC_URL=/
