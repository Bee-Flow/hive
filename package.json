{
    "name": "@beeflow/frontend",
    "version": "1.3.0",
    "private": true,
    "type": "module",
    "description": "Bee Flow — frontend SPA. The React + Vite client for every Bee Flow deployment (SaaS, self-hosted, Nextcloud ExApp).",
    "license": "SEE LICENSE IN LICENSE.md",
    "homepage": "https://beeflow.nl",
    "repository": {
        "type": "git",
        "url": "https://github.com/Bee-Flow/hive.git"
    },
    "bugs": {
        "url": "https://github.com/Bee-Flow/hive/issues"
    },
    "keywords": [
        "bee-flow",
        "ai",
        "agents",
        "nextcloud",
        "react",
        "vite"
    ],
    "files": [
        "dist",
        "!dist/**/*.map",
        "LICENSE.md",
        "README.md"
    ],
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "packageManager": "npm@10.9.0",
    "scripts": {
        "predev": "node scripts/generate-module-shims.mjs",
        "dev": "vite",
        "dev:clean": "rm -rf node_modules/.vite && vite",
        "prebuild": "node scripts/generate-module-shims.mjs",
        "build": "vite build",
        "build:analyze": "VITE_BUNDLE_ANALYZE=1 vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.0.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emoji-mart/data": "^1.2.1",
        "@monaco-editor/react": "^4.7.0",
        "@openobserve/browser-logs": "^0.3.4",
        "@openobserve/browser-rum": "^0.3.4",
        "@serenity-kit/opaque": "^1.1.0",
        "@tanstack/react-query": "^5.95.0",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.13.12",
        "@xyflow/react": "^12.10.2",
        "emoji-picker-react": "^4.18.0",
        "esbuild-wasm": "^0.25.12",
        "expr-eval": "^2.0.2",
        "highlight.js": "^11.11.1",
        "html2pdf.js": "^0.14.0",
        "jszip": "^3.10.1",
        "katex": "^0.16.42",
        "lucide-react": "^0.562.0",
        "mermaid": "^11.13.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-grid-layout": "^2.2.2",
        "react-markdown": "^10.1.0",
        "recharts": "^3.7.0",
        "rehype-katex": "^7.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "uuid": "^13.0.0",
        "vega": "^6.2.0",
        "vega-embed": "^7.1.0",
        "vega-lite": "^6.4.2",
        "web-vitals": "^5.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.1.6",
        "autoprefixer": "^10.4.22",
        "eslint": "^9.39.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "jsdom": "^28.1.0",
        "msw": "^2.14.6",
        "postcss": "^8.5.6",
        "rollup-plugin-visualizer": "^7.0.1",
        "tailwindcss": "^4.1.18",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "vite": "^7.2.4",
        "vitest": "^4.1.6"
    }
}
